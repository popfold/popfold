    { "id": "build", "name": "Right room", "camera": [2.6, 3.6, 7.2], "lookAt": [4.1, 1.1, -0.2], "set": { "c": 1, "L": 1, "R": 1, "glow": 0.4, "side": -1 } },
    { "id": "process", "name": "Overview", "camera": [0, 9.5, 13.5], "lookAt": [0, 0.9, 0], "set": { "c": 1, "L": 1, "R": 1, "glow": 0.7, "badges": 1, "side": 1 } },
