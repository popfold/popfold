{
  "name": "@popfold/engine",
  "version": "0.50.4",
  "description": "Alpha: scroll-driven 3D pocket homes that unfold into rooms (three.js), with a studio, a Vite plugin and a command line. Sites install it as `popfold` (npm:@popfold/engine). No backwards compatibility until 1.0.0.",
  "author": "Dimiter Todorov",
  "contributors": [
    "Alyssa Jacoby (creative director, Dopamine Spaces)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/popfold/popfold.git"
  },
  "homepage": "https://popfold.ca",
  "keywords": [
    "three.js",
    "3d",
    "scrollytelling",
    "vite",
    "storytelling",
    "web-component"
  ],
  "files": [
    "src",
    "lib",
    "bin",
    "assets",
    "schema",
    "templates",
    "docs",
    "skills",
    "tools",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "TODO.md",
    "CREDITS.md",
    "LICENSE",
    "!templates/*/node_modules",
    "!templates/*/dist",
    "!**/*.tsbuildinfo",
    "!**/__pycache__"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./studio": "./src/studio/studio.ts",
    "./vite": {
      "types": "./src/vite-plugin.ts",
      "default": "./lib/vite-plugin.js"
    },
    "./fallback": "./src/fallback.ts"
  },
  "bin": {
    "popfold": "./bin/popfold.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:pkg": "node --no-warnings tools/build-pkg.mjs",
    "release": "node tools/release.mjs",
    "test": "node --no-warnings tools/build-pkg.mjs --check && node --test \"test/*.test.ts\"",
    "test:browser": "node --test --test-concurrency=1 \"test-browser/*.test.ts\"",
    "lint": "biome lint"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "^1.3.0",
    "parse5": "8.0.1",
    "playwright-core": "^1.65.1",
    "sharp": "^0.35.5"
  },
  "peerDependencies": {
    "three": ">=0.180.0",
    "vite": ">=8.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "packageManager": "pnpm@12.18.0"
}
