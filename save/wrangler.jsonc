// The save service on Cloudflare. It stays on workers.dev until popfold.ca has moved to the Popfold account
// (ops/cloudflare-split.md); then it gets the route save.popfold.ca there. The account to deploy to comes from
// CLOUDFLARE_ACCOUNT_ID (or wrangler asks), so this public file names none.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "popfold-save",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "vars": {
    "GITHUB_CLIENT_ID": "",
    "GITHUB_APP_URL": ""
  }
}
